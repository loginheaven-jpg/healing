{
  "name": "@healing/web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "웹 서비스. Hono 서버 + React 클라이언트를 한 서비스로 배포합니다.",
  "scripts": {
    "dev": "pnpm run --parallel \"/^dev:/\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "build": "pnpm run build:server && pnpm run build:client",
    "build:server": "tsc -b tsconfig.server.json",
    "build:client": "vite build",
    "typecheck": "tsc -b tsconfig.server.json tsconfig.client.json",
    "start": "node dist/server/index.js"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "hono": "^4.6.16",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^7.0.0"
  }
}
