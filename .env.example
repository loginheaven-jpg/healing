# 힐링콰이어 환경변수
# docs/ARCHITECTURE.md 7.3절 목록입니다.
# 실제 값은 이 파일에 쓰지 말고 Railway 변수로만 관리하십시오.

# ── 데이터베이스 ────────────────────────────────────────────────
# Railway Postgres 가 주입합니다. 로컬은 docker 로 띄운 주소를 씁니다.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/healing

# ── 인증 ──────────────────────────────────────────────────────
# 통행 암호. 코드에 박지 마십시오. docs/SPEC.md 1.3
ACCESS_PASSKEY=healing
# 세션 쿠키 HMAC 서명 키. 32바이트 이상 무작위 값.
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-32-bytes-of-random-hex

# ── Cloudflare R2 (S3 API 호환) ────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=healing-choir
R2_ENDPOINT=https://<account>.r2.cloudflarestorage.com

# ── 공개 주소 ──────────────────────────────────────────────────
# 서명 URL 과 클라이언트 절대경로에 씁니다.
PUBLIC_BASE_URL=http://localhost:8080

# ── 런타임 ────────────────────────────────────────────────────
# Railway 가 PORT 를 주입합니다. 로컬 기본값은 8080.
PORT=8080
NODE_ENV=development
