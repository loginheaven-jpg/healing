node_modules/
dist/
build/
coverage/
*.tsbuildinfo

# tsc 산출물이 소스 옆에 떨어지는 사고를 막는 안전망.
#
# 실제로 한 번 일어났다. scripts/baseline.mts 가 omr-vector 소스를 경로로
# 직접 임포트하자, rootDir 밖의 파일이라 outDir 아래에 놓을 수 없어 tsc 가
# packages/omr-vector/src/ 에 .d.ts 16개를 떨궜고 그대로 커밋됐다(5c800b7).
# 그 파일들에는 낡은 WarningCode 가 들어 있어 "두 정의 공존" 이 됐다.
#
# 근본 원인은 막았다 — 워크스페이스 패키지는 반드시 이름으로 임포트한다.
# 이 규칙은 그것이 다시 뚫렸을 때의 두 번째 방어선이다.
**/src/**/*.d.ts
**/src/**/*.d.ts.map
**/src/**/*.js
**/src/**/*.js.map

# 설정 파일도 같은 사고를 낸다. src 아래가 아니라 패키지 뿌리에 있어서
# 위 규칙이 덮지 못한다. 실제로 drizzle.config.ts 를 tsconfig include 에
# 잠깐 넣었다가 .js/.d.ts 가 떨어졌다(P2 1단계에서 린트가 즉시 잡았다).
**/*.config.js
!eslint.config.js
**/*.config.d.ts
**/*.config.js.map
**/*.config.d.ts.map

# 환경변수. 실제 값은 Railway 변수로만 관리합니다. (.env.example 만 저장소에 둡니다)
.env
.env.*
!.env.example

# 편집기·OS
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/

# 로그
*.log
npm-debug.log*
pnpm-debug.log*

# 임시 산출물
/tmp/
/out/
.eslintcache

# 시안 원본의 중복 사본. 정본은 ui/desktop.html · ui/mobile.html 입니다.
/desktop.html
/mobile.html
# 브레이스 확장이 실패해 생긴 빈 디렉터리 잔재
/{docs*
scripts/probe/
packages/db/probe/
